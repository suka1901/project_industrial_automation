# The dataset: 2.1 GB of camera frames. Kept on disk and backed up separately,
# not in git - the repository is for the code that processes them.
model/dataset/raw/
model/dataset/label/
model/dataset/yolo/
*.zip

# Trained weights. Rebuildable from the dataset and train_yolo.ipynb.
model/*.pt
model/best_ncnn_model/
model/runs/

# Calibration output, which is specific to one physical setup.
pi/calibration/homography.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Editors and OS
.idea/
*.swp
Thumbs.db
desktop.ini

# Round-by-round training sets, rebuilt by split_dataset.py
model/dataset/_round*/
model/dataset/yolo_round*/

# Model weights and pre-annotation scratch
model/ina700_model.zip
model/dataset/label/predictions.json
model/dataset/label/_todo*
model/dataset/label/annotations/
model/dataset/yolo_full.zip
model/best_ncnn_model/

# Run-time log, rewritten on every run.
pi/logs/*.log

# Desktop scratch folder, not part of the project.
Claude outputs/

# Deployment bundle for the Pi, rebuilt on demand.
ina700-pi.tar.gz

# The station's Pack-and-Go and the built submission. Both are outputs, and
# the Pack-and-Go is made at the examination rather than kept here.
pack-and-go/*
!pack-and-go/README.txt
FinalProject_*.zip

# The Pi address this PC last deployed to.
.pi-address

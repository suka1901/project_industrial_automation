MODULE MainModule
	TASK PERS tooldata vac:=[TRUE,[[-90.2059,1.81102,177.839],[1,0,0,0]],[0.5,[50,0,50],[1,0,0,0],0,0,0]];
	TASK PERS wobjdata wobj1:=[FALSE,TRUE,"",[[610.644,-338.06,2.86545],[0.999893,-0.012613,0.00614853,0.00412147]],[[0,0,0],[1,0,0,0]]];
	TASK PERS wobjdata wobj2:=[FALSE,TRUE,"",[[606.487,221.202,2.06637],[0.999954,0.00362135,0.00617943,0.00640069]],[[0,0,0],[1,0,0,0]]];
	CONST robtarget Phome:=[[-62.06,293.24,107.36],[0.0144604,0.110376,-0.993465,-0.0252167],[-1,0,-1,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
	CONST robtarget Papproach:=[[-0.67,336.45,29.81],[0.014461,0.110376,-0.993465,-0.0252119],[-1,0,-1,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
	CONST robtarget p10:=[[30.12,28.62,-0.23],[0.0144628,0.110404,-0.993463,-0.0251784],[-1,-1,-1,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
	CONST robtarget p30:=[[153.79,26.47,3.87],[0.0144558,0.110389,-0.993464,-0.0251888],[-1,-1,-1,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
	CONST robtarget p40:=[[38.30,150.06,3.11],[0.0144435,0.110374,-0.993466,-0.0251758],[-1,0,-1,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
	CONST robtarget p50:=[[150.69,135.56,5.20],[0.0145033,0.110326,-0.993469,-0.0252387],[-1,0,-1,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];
	CONST robtarget p60:=[[91.66,86.91,1.39],[0.0144915,0.110364,-0.993465,-0.0252398],[-1,0,-1,0],[9E+09,9E+09,9E+09,9E+09,9E+09,9E+09]];

	! --- Lookup tables mapping a shape word to its picking robtarget ---
	! Index i in shapeNames corresponds to index i in shapeTargets.
	CONST string shapeNames{5} := ["square","circle","triangle","hexagon","star"];
	VAR robtarget shapeTargets{5} := [p10,p30,p40,p50,p60];


	PROC main()
		VAR string command;
		VAR string shapeName;
		VAR num idx;
		VAR bool running := TRUE;

		RobotAsClientConnect;
		TPErase;

		WHILE running DO
			TPWrite "Waiting for command from server...";
			command := RobotClientReciveMessage();

			IF command = "quit" THEN
				TPWrite "Quit command received. Shutting down.";
				running := FALSE;
			ELSE
				shapeName := ParseShapeName(command);
				idx := GetShapeIndex(shapeName);

				IF idx = -1 THEN
					TPWrite "Unknown command/shape: " + command;
					RobotClienSendMessage("ERROR: unknown shape '" + shapeName + "'");
				ELSE
					TPWrite "Press yellow button to begin picking " + shapeName;
					WaitDI diOkButton, 1;
					PickAndPlace shapeTargets{idx};
					RobotClienSendMessage("DONE: " + shapeName);
				ENDIF
			ENDIF
		ENDWHILE

		RobotClientCloseAndDisconnect;
	ENDPROC

	! Extracts the word after the first space in a command like "move square".
	! Works for any command word, not just "move", as long as there is exactly
	! one space separating the command from the shape name.
	FUNC string ParseShapeName(string command)
		VAR num spacePos;

		spacePos := StrFind(command, 1, " ");

		IF spacePos > StrLen(command) THEN
			! No space found -> treat the whole string as the shape name
			RETURN command;
		ENDIF

		RETURN StrPart(command, spacePos + 1, StrLen(command) - spacePos);
	ENDFUNC

	! Returns the index (1-5) of shapeName inside shapeNames, or -1 if not found.
	FUNC num GetShapeIndex(string shapeName)
		VAR num i;

		FOR i FROM 1 TO 5 DO
			IF shapeNames{i} = shapeName THEN
				RETURN i;
			ENDIF
		ENDFOR

		RETURN -1;
	ENDFUNC

	! Generic pick-and-place routine used for every shape.
	! pickPos: the robtarget where the requested object currently is (picked
	! in wobj1). The object is placed at the SAME target number, but resolved
	! against wobj2 instead - matching the original per-shape procedures
	! (e.g. square uses p10 for both pick, in wobj1, and place, in wobj2).
	PROC PickAndPlace(robtarget pickPos)
		MoveJ Phome, v200, fine, vac\WObj:=wobj1;
		MoveL Papproach, v200, fine, vac\WObj:=wobj1;
		MoveL Offs(pickPos, 0, 0, 20), v200, fine, vac\WObj:=wobj1;
		MoveL pickPos, v200, fine, vac\WObj:=wobj1;
		WaitTime 0.5;
		pick;
		MoveL Offs(pickPos, 0, 0, 20), v200, fine, vac\WObj:=wobj1;

		MoveL Offs(pickPos, 0, 0, 20), v200, fine, vac\WObj:=wobj2;
		MoveL pickPos, v200, fine, vac\WObj:=wobj2;
		WaitTime 0.5;
		place;
		MoveL Offs(pickPos, 0, 0, 20), v200, fine, vac\WObj:=wobj2;

		MoveJ Phome, v200, fine, vac\WObj:=wobj1;
	ENDPROC

	! Pick an object (vacuum on)
	PROC pick()
		setDo doValve1, 1;
		WaitTime 0.5;
	ENDPROC

	! Release an object (vacuum off)
	PROC place()
		setDo doValve1, 0;
		WaitTime 0.5;
	ENDPROC

ENDMODULE

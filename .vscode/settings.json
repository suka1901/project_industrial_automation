{
    "python-envs.defaultEnvManager": "ms-python.python:conda",
    "python-envs.defaultPackageManager": "ms-python.python:conda",

    // Analyse every file in the project, not only the ones open in a tab,
    // so the Problems panel shows the whole picture at once. What is analysed
    // and how strictly lives in pyrightconfig.json, which the command line
    // reads as well.
    "python.analysis.diagnosticMode": "workspace"
}

{
    // One place where VS Code's Pylance and a command-line `pyright` agree,
    // so the Problems panel and a terminal check never disagree about what
    // is wrong.

    // The code this project is responsible for. Everything else under the
    // repository is data or output.
    "include": ["pi", "make_submission.py"],

    // model/ holds the dataset and the exported ncnn model, whose Python
    // file is generated by the exporter and is not ours to fix.
    "exclude": ["**/__pycache__", "**/.pytest_cache", "model", "pack-and-go"],

    // "pi" is the import root at run time (main.py lives there); "." is what
    // the submission test uses to reach make_submission.py.
    "extraPaths": ["pi", "."],

    "pythonVersion": "3.11",
    "typeCheckingMode": "basic"
}
